{
  "manifest_version": 3,
  "name": "Muse 自动审批助手",
  "version": "7.2.1",
  "description": "协议优先双引擎（RPC主动查单为主 + Closed Shadow DOM/iframe穿透兜底），全自动审批 Muse.ai 助手权限，防误点与真实计数",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Muse 自动审批助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*",
        "http://muse.ai/*",
        "http://*.muse.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
